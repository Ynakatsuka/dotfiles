#!/usr/bin/env bash
# Mirror Claude Code user skills into ~/.agents/skills via symlinks.
#
# Why this script exists:
#   Codex honors the same SKILL.md frontmatter format as Claude Code, but reads
#   user skills from ~/.agents/skills/ instead of ~/.claude/skills/. Maintaining
#   a duplicate copy in dot_agents/skills/ would drift; dot_claude/skills/
#   is the single source and each user skill is linked into the Codex skills
#   directory.
#
# Scope:
#   - Links every directory under dot_claude/skills/ that ships a SKILL.md.
#   - The run_once_before_migrate-shared-skills.sh script moves the four
#     formerly agent-owned directories before this script creates links.
#   - Leaves ~/.claude/skills/ directories untouched unless chezmoi manages
#     them directly. Unmanaged user skills must not be deleted by this sync.
#   - Leaves non-symlink entries under ~/.agents/skills/ untouched.
#   - Records links created under ~/.agents/skills/ and prunes only stale links
#     from that ownership manifest.
#   - Removes links created by the former ~/.codex/skills/ mirror without
#     touching unrelated entries or ~/.codex/skills/.system/.
#
# Trigger:
#   The run_onchange_ prefix re-runs this script whenever the inlined skill
#   name list changes (i.e. when a skill directory is added or removed).

set -euo pipefail

CLAUDE_SKILLS="${HOME}/.claude/skills"
AGENT_SKILLS="${HOME}/.agents/skills"
MANAGED_SKILLS_FILE="${AGENT_SKILLS}/.codex-claude-managed-skills"

mkdir -p "${AGENT_SKILLS}"

if [[ -L "${MANAGED_SKILLS_FILE}" || ( -e "${MANAGED_SKILLS_FILE}" && ! -f "${MANAGED_SKILLS_FILE}" ) ]]; then
  echo "ERROR: Codex skill ownership manifest is not a regular file: ${MANAGED_SKILLS_FILE}" >&2
  exit 1
fi

# Inlined list of skill names. Adding or removing a skill changes this list,
# which changes the rendered script and re-triggers run_onchange_.
skills=(
{{- range $path := glob (joinPath .chezmoi.sourceDir "dot_claude/skills/*/SKILL.md") }}
  {{ $path | dir | base | quote }}
{{- end }}
)

is_managed_skill() {
  local candidate="$1"
  local keep
  for keep in "${skills[@]}"; do
    if [[ "${candidate}" == "${keep}" ]]; then
      return 0
    fi
  done
  return 1
}

previous_managed_skills=()
if [[ -f "${MANAGED_SKILLS_FILE}" ]]; then
  while IFS= read -r skill || [[ -n "${skill}" ]]; do
    [[ -n "${skill}" ]] || continue
    case "${skill}" in
      *[!A-Za-z0-9._-]*)
        echo "ERROR: Invalid skill name in ownership manifest: ${skill}" >&2
        exit 1
        ;;
    esac
    previous_managed_skills+=("${skill}")
  done <"${MANAGED_SKILLS_FILE}"
fi

for skill in "${skills[@]}"; do
  src="${CLAUDE_SKILLS}/${skill}"
  dst="${AGENT_SKILLS}/${skill}"
  if [[ ! -d "${src}" ]]; then
    echo "Source skill missing, skipping: ${src}" >&2
    continue
  fi
  if [[ -e "${dst}" && ! -L "${dst}" ]]; then
    echo "ERROR: Codex skill destination exists and is not a symlink: ${dst}" >&2
    echo "Move or delete it manually before re-running chezmoi apply." >&2
    exit 1
  fi
  ln -sfn "${src}" "${dst}"
  echo "Linked ${dst} -> ${src}"
done

# Prune only links recorded by an earlier successful run. A link target alone
# cannot distinguish this script's links from user-owned cross-client links.
for skill in ${previous_managed_skills[@]+"${previous_managed_skills[@]}"}; do
  is_managed_skill "${skill}" && continue
  entry="${AGENT_SKILLS}/${skill}"
  [[ -L "${entry}" ]] || continue
  target="$(readlink "${entry}")"
  if [[ "${target}" == "${CLAUDE_SKILLS}/${skill}" ]]; then
    echo "Pruning stale managed skill symlink: ${entry}"
    rm -f "${entry}"
  fi
done

manifest_tmp="$(mktemp "${AGENT_SKILLS}/.codex-claude-managed-skills.XXXXXX")"
trap 'rm -f "${manifest_tmp}"' EXIT
printf '%s\n' "${skills[@]}" >"${manifest_tmp}"
mv "${manifest_tmp}" "${MANAGED_SKILLS_FILE}"
trap - EXIT

# This explicit migration list is the ownership record for the former mirror.
# New skills are never written under ~/.codex/skills/.
legacy_codex_skills=(
  "my-agent"
  "my-agent-friendly-code"
  "my-bullets"
  "my-ccv"
  "my-diagnose"
  "my-disk-cleanup"
  "my-epic"
  "my-explain-diff"
  "my-guided-tour"
  "my-handoff"
  "my-pr"
  "my-pr-briefing"
  "my-refactor"
  "my-release-note"
  "my-sdd"
  "my-skill-creator"
  "my-stop-ai-slop-jp"
  "my-subagent"
  "my-team-share"
  "my-update-models"
  "my-worktree"
)
for skill in "${legacy_codex_skills[@]}"; do
  entry="${HOME}/.codex/skills/${skill}"
  [[ -L "${entry}" ]] || continue
  target="$(readlink "${entry}")"
  if [[ "${target}" == "${CLAUDE_SKILLS}/${skill}" ]]; then
    echo "Pruning legacy Codex skill symlink: ${entry}"
    rm -f "${entry}"
  fi
done

echo ""
echo "Codex skills sync complete (${#skills[@]} skill(s) linked)."

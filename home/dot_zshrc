#
# Executes commands at the start of an interactive session.
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"

  # Claude Code sources this file in a non-interactive shell and replays the
  # resulting options and aliases in every Bash tool call. Nobody can answer a
  # prompt there, so drop Prezto's overwrite guard and `-i` aliases. Interactive
  # shells keep both, even when started under Claude Code.
  if [[ -n "$CLAUDECODE" && ! -o interactive ]]; then
    setopt CLOBBER
    unalias cp ln mv rm
  fi
fi

# Source modular zsh configuration files
_zsh_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
if [[ -d "$_zsh_config_dir" ]]; then
  for _zsh_config_file in \
    "$_zsh_config_dir/prompt.zsh" \
    "$_zsh_config_dir/aliases.zsh" \
    "$_zsh_config_dir/abbr.zsh" \
    "$_zsh_config_dir/keybindings.zsh" \
    "$_zsh_config_dir/git-worktree.zsh" \
    "$_zsh_config_dir/codex.zsh" \
    "$_zsh_config_dir/fzf.zsh" \
    "$_zsh_config_dir/copy-last-output.zsh" \
    "$_zsh_config_dir/claude.zsh" \
    "$_zsh_config_dir/gcloud.zsh" \
    "$_zsh_config_dir/tools.zsh"; do
    [[ -f "$_zsh_config_file" ]] && source "$_zsh_config_file"
  done
  unset _zsh_config_file
fi
unset _zsh_config_dir

{{- $sshSigner := "/opt/1Password/op-ssh-sign" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $sshSigner = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
{{- end -}}
{{- if stat $sshSigner -}}
# Keep other SSH hosts on their existing authentication settings.
Host github.com
{{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
  IdentityAgent ~/.1password/agent.sock
{{- end }}
  IdentityFile ~/.ssh/1password-github.pub
  IdentitiesOnly yes
{{ end -}}

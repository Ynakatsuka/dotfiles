{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "actions": {
    "difit-review": {
      "type": "command",
      "title": "Open Difit Review",
      "subtitle": "Review the current Git diff in cmux",
      "keywords": ["difit", "diff", "review", "git"],
      "palette": true,
      "command": "\"$HOME/.local/bin/difit-cmux\" && exit",
      "target": "newTabInCurrentPane"
    },
    "resume-all-codex-sessions": {
      "type": "command",
      "title": "Resume All Codex Sessions",
      "subtitle": "Restart every Codex tab from its saved session",
      "keywords": ["codex", "resume", "restart", "session", "all tabs"],
      "palette": true,
      "command": "\"$HOME/.local/libexec/cmux/resume-all-codex-sessions\" && exit",
      "target": "newTabInCurrentPane"
    }
  },

  "customSidebars": {
    "renderer": "inProcess"
  },

  "app": {
    "appearance": "dark"
  },

  "sidebarAppearance": {
    "darkModeTintColor": "#808080",
    "tintOpacity": 0.2
  },

  "shortcuts": {
    "bindings": {
      "nextSurface": "cmd+shift+→",
      "prevSurface": "cmd+shift+←"
    }
  }
}

{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "disableAutoMode": "disable",
    "deny": [
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-mojibake.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/bulk-read-guard"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/ensure-mise-path.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/bulk-read-guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/orca-claude-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/orca-claude-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/ccv-statusline-proxy.sh"
  },
  "skipDangerousModePermissionPrompt": true,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "plansDirectory": "./.plans",
  "autoUpdatesChannel": "latest",
  "model": "opus",
  "language": "japanese",
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "autoCompactWindow": 500000,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "switchModelsOnFlag": false,
  "cleanupPeriodDays": 180
}

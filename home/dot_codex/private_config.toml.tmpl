{{- /* Settings that Codex and the ChatGPT app write into the deployed file. */ -}}
{{- $codexConfig := joinPath .chezmoi.homeDir ".codex/config.toml" -}}
{{- $runtimeConfig := dict -}}
{{- if stat $codexConfig -}}
{{- $runtimeConfig = include $codexConfig | fromToml -}}
{{- end -}}
{{- /* Keep app-owned service registrations, but do not deploy a missing browser executable. */ -}}
{{- $nodeReplEnabled := dig "mcp_servers" "node_repl" "enabled" true $runtimeConfig -}}
{{- $trustedServicesJson := dig "mcp_servers" "node_repl" "env" "NODE_REPL_TRUSTED_SERVICES" "" $runtimeConfig -}}
{{- if and $nodeReplEnabled $trustedServicesJson -}}
{{- $trustedServices := $trustedServicesJson | fromJson -}}
{{- if not (kindIs "map" $trustedServices) -}}
{{- fail "Codex NODE_REPL_TRUSTED_SERVICES must be a JSON object; repair the app-owned service registration before applying dotfiles." -}}
{{- end -}}
{{- if hasKey $trustedServices "browser" -}}
{{- $browserService := get $trustedServices "browser" -}}
{{- if or (not (kindIs "string" $browserService)) (not $browserService) -}}
{{- fail "Codex trusted browser service must be a non-empty string; repair the app-owned service registration before applying dotfiles." -}}
{{- end -}}
{{- if isAbs $browserService -}}
{{- $serviceFile := stat $browserService -}}
{{- if or (not $serviceFile) (ne $serviceFile.type "file") -}}
{{- fail "Codex trusted browser service path is not an existing file. Refresh the Browser plugin through the ChatGPT app, verify its service registration, then restart MCP before applying dotfiles. Do not substitute another cached version." -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
hide_agent_reasoning = true
network_access = true
web_search = "live"
approval_policy = "never"
sandbox_mode = "danger-full-access"
model = "gpt-6.1-sol"
model_reasoning_effort = "high"
service_tier = "default"
suppress_unstable_features_warning = true
{{- /* Preserve the ChatGPT app's Computer Use turn notifier; top-level keys must precede tables. */}}
{{- if hasKey $runtimeConfig "notify" }}
{{ dict "notify" (get $runtimeConfig "notify") | toToml | trim }}
{{- end }}

[features]
# Avoid repeated parent-model calls while waiting for subagents.
multi_agent_v2.enabled = true
multi_agent_v2.min_wait_timeout_ms = 120000
multi_agent_v2.default_wait_timeout_ms = 120000
default_mode_request_user_input = true

[features.context_management]
experimental_mode = true

[tools]
streamable_shell = true

[agents]
max_concurrent_threads_per_session = 6
max_depth = 1
default_subagent_model = "gpt-6.1-sol"
default_subagent_reasoning_effort = "high"

[tui]
copy_on_select = "never"
status_line = [
  "model-with-reasoning",
  "fast-mode",
  "git-branch",
  "branch-changes",
  "context-remaining",
  "five-hour-limit",
  "weekly-limit",
  "used-tokens",
  "current-dir",
]

{{- $managedProjects := list .chezmoi.homeDir }}
{{- if lookPath "ghq" }}
{{- range $repo := (splitList "\n" (trim (output "ghq" "list" "-p"))) }}
{{- if $repo }}
{{- $managedProjects = append $managedProjects $repo }}
[projects.{{ $repo | quote }}]
trust_level = "trusted"

{{- end }}
{{- end }}
{{- end }}
{{/* Preserve Codex's runtime hook trust state across chezmoi applies. */ -}}
{{- if stat $codexConfig }}
{{- $hookState := trim (output "awk" "BEGIN { in_hooks = 0 } /^\\[hooks\\.state\\]$/ { in_hooks = 1; print; next } in_hooks && /^\\[/ && $0 !~ /^\\[hooks\\.state(\\]|\\.)/ { in_hooks = 0 } in_hooks { print }" $codexConfig) }}
{{- if $hookState }}

{{ $hookState -}}
{{- end }}
{{/* Preserve desktop preferences and trust entries outside managed repositories. */}}
{{- if hasKey $runtimeConfig "desktop" }}
{{ dict "desktop" (get $runtimeConfig "desktop") | toToml }}
{{- end }}
{{/* Preserve the plugins and MCP servers that the ChatGPT app registers. */}}
{{- range $table := list "marketplaces" "plugins" "mcp_servers" }}
{{- if hasKey $runtimeConfig $table }}
{{ dict $table (get $runtimeConfig $table) | toToml }}
{{- end }}
{{- end }}
{{- if hasKey $runtimeConfig "projects" }}
{{- range $project, $settings := $runtimeConfig.projects }}
{{- if not (has $project $managedProjects) }}
[projects.{{ $project | quote }}]
{{ $settings | toToml | trim }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

[projects.{{ .chezmoi.homeDir | quote }}]
trust_level = "trusted"

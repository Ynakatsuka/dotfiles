{{- $hooksPath := joinPath .chezmoi.homeDir ".codex/hooks.json" -}}
{{- $base := dict "hooks" (dict) -}}
{{- if stat $hooksPath -}}
{{- $base = include $hooksPath | fromJson -}}
{{- end -}}
{{- $bulkReadGuard := "\"$HOME/.local/bin/bulk-read-guard\"" -}}
{{ output "jq" "-n" "--argjson" "base" ($base | toJson) "--arg" "bulkReadGuard" $bulkReadGuard `
  def without_commands(pattern):
    map(
      if ((.hooks // null) | type) == "array" then
        .hooks = [
          .hooks[]
          | select(((.command // "") | test(pattern; "i")) | not)
        ]
      else .
      end
    )
    | map(select(((.hooks // null) | type) != "array" or (.hooks | length) > 0));

  $base
  | .hooks = (.hooks // {})
  | .hooks |= with_entries(
      .value |= (
        without_commands("(^|[[:space:]/])cmux([[:space:]/]|$)")
        | without_commands("bulk-read-guard")
      )
    )
  | .hooks.PreToolUse = (
      (.hooks.PreToolUse // [])
      + [{"matcher": "Bash", "hooks": [{"command": $bulkReadGuard, "timeout": 10, "type": "command"}]}]
    )
` -}}

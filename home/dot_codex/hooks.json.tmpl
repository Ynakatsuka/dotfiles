{{- $hooksPath := joinPath .chezmoi.homeDir ".codex/hooks.json" -}}
{{- $base := dict "hooks" (dict) -}}
{{- if stat $hooksPath -}}
{{- $base = include $hooksPath | fromJson -}}
{{- end -}}
{{ output "jq" "-n" "--argjson" "base" ($base | toJson) `
  def without_cmux_hooks:
    map(
      if ((.hooks // null) | type) == "array" then
        .hooks = [
          .hooks[]
          | select(
              ((.command // "")
                | test("(^|[[:space:]/])cmux([[:space:]/]|$)"; "i"))
              | not
            )
        ]
      else .
      end
    )
    | map(select(((.hooks // null) | type) != "array" or (.hooks | length) > 0));

  $base
  | .hooks = (.hooks // {})
  | .hooks |= with_entries(.value |= without_cmux_hooks)
` -}}

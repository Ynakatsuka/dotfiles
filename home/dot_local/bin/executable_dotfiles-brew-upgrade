#!/usr/bin/env bash
# Upgrade Homebrew packages while leaving Chrome cask updates to Chrome itself.

set -euo pipefail

CASK_LIST=""
FILTERED_CASK_LIST=""

cleanup() {
  if [ -n "$CASK_LIST" ]; then
    rm -f "$CASK_LIST"
  fi
  if [ -n "$FILTERED_CASK_LIST" ]; then
    rm -f "$FILTERED_CASK_LIST"
  fi
}

orca_ide_installed() {
  local orca_cli
  orca_cli="$(command -v orca)" || return 1
  [[ "$(readlink "$orca_cli" 2>/dev/null || printf '%s' "$orca_cli")" == */Orca.app/Contents/Resources/bin/orca ]]
}

main() {
  CASK_LIST="$(mktemp)"
  FILTERED_CASK_LIST="$(mktemp)"
  trap cleanup EXIT

  brew update
  brew upgrade --formula

  # Homebrew omits auto-updating casks such as Orca from the default outdated list.
  # An older Homebrew cask also uses the "orca" token, so check the IDE CLI
  # before upgrading that token through the Orca IDE tap.
  if brew list --cask stablyai/orca/orca >/dev/null 2>&1 ||
    { brew list --cask orca >/dev/null 2>&1 && orca_ide_installed; }; then
    brew upgrade --cask stablyai/orca/orca
  fi

  brew outdated --cask --quiet >"$CASK_LIST"
  awk '
    $0 == "google-chrome" {
      skipped = 1
      next
    }
    { print }
    END {
      if (skipped) {
        print "[INFO] Skipping google-chrome cask upgrade; Chrome self-updates, and replacing its running app bundle can crash open sessions." > "/dev/stderr"
      }
    }
  ' "$CASK_LIST" >"$FILTERED_CASK_LIST"

  if [ -s "$FILTERED_CASK_LIST" ]; then
    xargs brew upgrade --cask <"$FILTERED_CASK_LIST"
  else
    echo "[INFO] No outdated Homebrew casks to upgrade"
  fi

  brew cleanup -s
  brew autoremove
}

main "$@"

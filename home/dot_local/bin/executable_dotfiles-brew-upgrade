#!/usr/bin/env bash
# Upgrade Homebrew packages while leaving self-updating Chrome and Orca casks
# to their in-app updaters.

set -euo pipefail

CASK_LIST=""
FILTERED_CASK_LIST=""

cleanup() {
  if [ -n "$CASK_LIST" ]; then
    rm -f "$CASK_LIST"
  fi
  if [ -n "$FILTERED_CASK_LIST" ]; then
    rm -f "$FILTERED_CASK_LIST"
  fi
}

orca_ide_installed() {
  local orca_cli
  orca_cli="$(command -v orca)" || return 1
  [[ "$(readlink "$orca_cli" 2>/dev/null || printf '%s' "$orca_cli")" == */Orca.app/Contents/Resources/bin/orca ]]
}

main() {
  local skip_orca_token=0

  CASK_LIST="$(mktemp)"
  FILTERED_CASK_LIST="$(mktemp)"
  trap cleanup EXIT

  brew update
  # Orphaned dependencies can be disabled formulae that make the upgrade fail.
  brew autoremove
  brew upgrade --formula

  # Orca self-updates via Squirrel; replacing /Applications/Orca.app while Orca
  # is running invalidates app.asar chunk hashes and worker paths, crashing open
  # sessions. Leave Orca updates to the in-app updater (matching its cask's
  # auto_updates true) and also guard against outdated-list upgrades.
  if orca_ide_installed; then
    skip_orca_token=1
  fi

  brew outdated --cask --quiet >"$CASK_LIST"
  awk -v skip_orca_token="$skip_orca_token" '
    $0 == "google-chrome" {
      skipped_chrome = 1
      next
    }
    $0 == "stablyai/orca/orca" || (skip_orca_token == 1 && $0 == "orca") {
      skipped_orca = 1
      next
    }
    { print }
    END {
      if (skipped_chrome) {
        print "[INFO] Skipping google-chrome cask upgrade; Chrome self-updates, and replacing its running app bundle can crash open sessions." > "/dev/stderr"
      }
      if (skipped_orca) {
        print "[INFO] Skipping orca cask upgrade; Orca self-updates, and replacing its running app bundle can crash open sessions." > "/dev/stderr"
      }
    }
  ' "$CASK_LIST" >"$FILTERED_CASK_LIST"

  if [ -s "$FILTERED_CASK_LIST" ]; then
    xargs brew upgrade --cask <"$FILTERED_CASK_LIST"
  else
    echo "[INFO] No outdated Homebrew casks to upgrade"
  fi

  brew cleanup -s
  brew autoremove
}

main "$@"

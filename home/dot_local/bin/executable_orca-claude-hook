#!/usr/bin/env bash
# Claude Code hook for sessions that run inside Orca.
#
# Keeps a guard in Orca's managed ~/.orca/agent-hooks/claude-hook.sh that drops
# a Stop which only waits for background work (see orca-claude-stop-held).
# Orca announces such a Stop as "Agent Task Complete" even though Claude
# resumes when the work finishes. Orca rewrites the script at every app start,
# so SessionStart and UserPromptSubmit reinstall the guard.
#
# The workspace board status is left to the user: the sidebar groups workspaces
# by status, so changing it on every turn would move them around.
#
# Writes nothing to stdout, because Claude adds UserPromptSubmit output to the
# prompt context.

set -euo pipefail

readonly GUARD_MARKER='# dotfiles:orca-claude-stop-held'
readonly PAYLOAD_ANCHOR='payload=$({ command -p cat 2>/dev/null || cat; })'

error() {
  printf 'orca-claude-hook: %s\n' "$*" >&2
}

install_stop_guard() {
  local script="$HOME/.orca/agent-hooks/claude-hook.sh" guard tmp
  [[ -f "$script" ]] || return 0
  if grep -Fq "$GUARD_MARKER" "$script"; then
    return 0
  fi
  if ! grep -Fxq "$PAYLOAD_ANCHOR" "$script"; then
    error "Orca changed how claude-hook.sh reads the payload; update the guard in orca-claude-hook: $script"
    return 1
  fi

  # read -d '' instead of $(cat <<EOF): the guard's case pattern has an unmatched ")".
  IFS= read -r -d '' guard <<'EOF' || true
# dotfiles:orca-claude-stop-held (installed by ~/.local/bin/orca-claude-hook)
case "$payload" in *'"Stop"'*) if [ -x "$HOME/.local/bin/orca-claude-stop-held" ] && printf '%s' "$payload" | "$HOME/.local/bin/orca-claude-stop-held"; then exit 0; fi ;; esac
EOF
  guard=${guard%$'\n'}
  # cp -p keeps Orca's mode; its settings command runs the script only when executable.
  tmp=$(mktemp "$script.dotfiles.XXXXXX") &&
    cp -p "$script" "$tmp" &&
    GUARD=$guard ANCHOR=$PAYLOAD_ANCHOR awk '
      { print }
      $0 == ENVIRON["ANCHOR"] && !inserted { print ENVIRON["GUARD"]; inserted = 1 }
    ' "$script" >"$tmp" &&
    mv -f "$tmp" "$script" || {
    [[ -z "${tmp:-}" ]] || rm -f "$tmp"
    error "failed to install the Stop guard into $script"
    return 1
  }
}

# The payload is not needed; drain it so Claude's write does not fail.
cat >/dev/null
install_stop_guard

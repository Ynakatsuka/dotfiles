#!/usr/bin/env python3
"""Refresh Git diff data embedded in the cmux Agent Board runtime sidebar."""

from __future__ import annotations

import base64
import fcntl
import json
import math
import os
import signal
import stat
import subprocess
import tempfile
import time
from pathlib import Path
from typing import Any


BEGIN = "// BEGIN CMUX_DIFF_DATA (managed by cmux-agent-board-diff-refresh)"
END = "// END CMUX_DIFF_DATA"
MAX_FILES_LISTED = 20
MAX_UNTRACKED_BYTES = 2_000_000
UNTRACKED_REFRESH_SECONDS = 120
GIT_TIMEOUT_SECONDS = 15
USAGE_TIMEOUT_SECONDS = 25
USAGE_PROVIDERS = ("codex", "claude", "cursor")
CACHE_VERSION = 1


def configured_path(variable: str, default: Path) -> Path:
    return Path(os.environ.get(variable, str(default))).expanduser()


def read_only_git_environment() -> dict[str, str]:
    environment = os.environ.copy()
    environment["GIT_OPTIONAL_LOCKS"] = "0"
    return environment


def configured_timeout(variable: str, default: float) -> float:
    configured = os.environ.get(variable)
    if configured is None:
        return default
    try:
        timeout = float(configured)
    except ValueError as error:
        raise RuntimeError(f"{variable} must be a positive number") from error
    if timeout <= 0:
        raise RuntimeError(f"{variable} must be a positive number")
    return timeout


def run_command(
    command: list[str],
    *,
    cwd: Path | None = None,
    environment: dict[str, str] | None = None,
    timeout: float = GIT_TIMEOUT_SECONDS,
) -> str:
    result = subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        capture_output=True,
        text=True,
        errors="surrogateescape",
        timeout=timeout,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(message or f"command failed: {' '.join(command)}")
    return result.stdout


def git(directory: Path, *arguments: str) -> str:
    return run_command(
        ["git", "-c", "core.quotepath=false", *arguments],
        cwd=directory,
        environment=read_only_git_environment(),
    )


def workspace_directories(cmux_bin: str) -> list[Path]:
    output = run_command([cmux_bin, "--json", "workspace", "list"])
    document = json.loads(output)
    if not isinstance(document, dict) or not isinstance(document.get("workspaces"), list):
        raise RuntimeError("cmux workspace list did not contain a workspaces array")

    directories: list[Path] = []
    for workspace in document["workspaces"]:
        if not isinstance(workspace, dict):
            raise RuntimeError("cmux workspace list contained an invalid workspace")
        directory = workspace.get("current_directory")
        if directory is None:
            continue
        if not isinstance(directory, str):
            raise RuntimeError("cmux workspace current_directory was not a string")
        if directory:
            directories.append(Path(directory).expanduser())
    return directories


def git_toplevel(directory: Path) -> Path | None:
    if not directory.is_dir():
        return None

    result = subprocess.run(
        ["git", "-c", "core.quotepath=false", "rev-parse", "--show-toplevel"],
        cwd=directory,
        env=read_only_git_environment(),
        capture_output=True,
        text=True,
        errors="surrogateescape",
        timeout=GIT_TIMEOUT_SECONDS,
    )
    if result.returncode == 0:
        top = result.stdout.strip()
        if not top:
            raise RuntimeError("git rev-parse returned an empty worktree path")
        return Path(top)

    if "not a git repository" in result.stderr.lower():
        return None
    message = result.stderr.strip() or result.stdout.strip()
    raise RuntimeError(message or "git rev-parse --show-toplevel failed")


def repository_toplevels(directories: list[Path]) -> list[Path]:
    toplevels: dict[str, Path] = {}
    for directory in directories:
        top = git_toplevel(directory)
        if top is not None:
            toplevels.setdefault(str(top), top)
    return [toplevels[key] for key in sorted(toplevels)]


def sanitized_field(value: str) -> str:
    clean = "".join(character for character in value if character.isprintable())
    for unsupported, replacement in (
        ('"', "?"),
        ("\\", "/"),
        ("|", "?"),
        (";", "?"),
    ):
        clean = clean.replace(unsupported, replacement)
    return clean[-200:]


def path_token(value: str) -> str:
    encoded = value.encode("utf-8", errors="surrogateescape")
    return base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("=")


def tree_rows(entries: list[dict[str, Any]]) -> str:
    root: dict[str, Any] = {"children": {}, "entry": None}
    for entry in sorted(entries, key=lambda item: item["path"]):
        components = entry["path"].split("/")
        node = root
        for component in components[:-1]:
            node = node["children"].setdefault(
                component, {"children": {}, "entry": None}
            )
        node["children"][components[-1]] = {"children": {}, "entry": entry}

    rows: list[str] = []

    def append_children(node: dict[str, Any], depth: int) -> None:
        children = node["children"]
        names = sorted(
            children,
            key=lambda name: (
                children[name]["entry"] is not None,
                name.casefold(),
                name,
            ),
        )
        for name in names:
            child = children[name]
            indent = "  " * depth + " "
            entry = child["entry"]
            if entry is None:
                rows.append(f"D|{indent}|{sanitized_field(name)}")
                append_children(child, depth + 1)
                continue
            rows.append(
                "|".join(
                    (
                        "F",
                        indent,
                        str(entry["kind"]),
                        str(entry["added"]),
                        str(entry["deleted"]),
                        sanitized_field(name),
                        sanitized_field(entry["path"]),
                        path_token(entry["path"]),
                    )
                )
            )

    append_children(root, 0)
    return ";".join(rows)


def swift_literal(value: str) -> str:
    if '"' in value or "\\" in value:
        raise RuntimeError("path cannot be represented in the cmux sidebar interpreter")
    return value


def untracked_counts(file_path: Path) -> tuple[int | str, int | str]:
    file_stat = file_path.lstat()
    if not stat.S_ISREG(file_stat.st_mode):
        return "-", "-"
    size = file_stat.st_size
    if size > MAX_UNTRACKED_BYTES:
        return "-", "-"

    line_breaks = 0
    last_byte = b""
    with file_path.open("rb") as file:
        for block in iter(lambda: file.read(65536), b""):
            if b"\0" in block:
                return "-", "-"
            line_breaks += block.count(b"\n")
            last_byte = block[-1:]
    if size and last_byte != b"\n":
        line_breaks += 1
    return line_breaks, 0


def status_kind(status: str) -> str:
    if "D" in status:
        return "D"
    if "A" in status or status == "??":
        return "N"
    return "M"


def load_untracked_cache(path: Path) -> dict[str, Any]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"version": CACHE_VERSION, "repositories": {}}

    if not isinstance(document, dict) or document.get("version") != CACHE_VERSION:
        raise RuntimeError("cmux Agent Board diff cache has an invalid version")
    repositories = document.get("repositories")
    if not isinstance(repositories, dict):
        raise RuntimeError("cmux Agent Board diff cache has invalid repositories")
    for top, record in repositories.items():
        if not isinstance(top, str) or not isinstance(record, dict):
            raise RuntimeError("cmux Agent Board diff cache has an invalid repository")
        scanned_at = record.get("scanned_at")
        entries = record.get("entries")
        if not isinstance(scanned_at, (int, float)) or not isinstance(entries, list):
            raise RuntimeError("cmux Agent Board diff cache has an invalid scan record")
        for entry in entries:
            if (
                not isinstance(entry, dict)
                or entry.get("kind") != "N"
                or not isinstance(entry.get("path"), str)
                or not isinstance(entry.get("added"), (int, str))
                or not isinstance(entry.get("deleted"), (int, str))
            ):
                raise RuntimeError("cmux Agent Board diff cache has an invalid entry")
    return document


def diff_base(top: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", "HEAD"],
        cwd=top,
        env=read_only_git_environment(),
        capture_output=True,
        text=True,
        errors="surrogateescape",
        timeout=GIT_TIMEOUT_SECONDS,
    )
    if result.returncode == 0:
        return "HEAD"
    if result.returncode != 1:
        message = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(message or "git rev-parse --verify HEAD failed")

    empty_tree = git(top, "hash-object", "-t", "tree", "/dev/null").strip()
    if not empty_tree:
        raise RuntimeError("git hash-object returned an empty tree ID")
    return empty_tree


def repository_changes(
    top: Path,
    cached_untracked: list[dict[str, Any]],
    scan_untracked: bool,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]] | None]:
    entries: dict[str, dict[str, Any]] = {}
    tracked_statuses: dict[str, str] = {}
    untracked_entries: list[dict[str, Any]] = []
    untracked_option = "-uall" if scan_untracked else "-uno"
    status = git(
        top,
        "status",
        "--porcelain=v1",
        "-z",
        untracked_option,
        "--no-renames",
    )
    for record in status.split("\0"):
        if not record:
            continue
        if len(record) < 4 or record[2] != " ":
            raise RuntimeError("git status returned an invalid porcelain record")
        code, file_name = record[:2], record[3:]
        if code == "!!":
            continue
        if code == "??":
            added, deleted = untracked_counts(top / file_name)
            entries[file_name] = {
                "kind": "N",
                "added": added,
                "deleted": deleted,
                "path": file_name,
            }
            untracked_entries.append(entries[file_name])
        else:
            tracked_statuses[file_name] = code

    if tracked_statuses:
        numstat = git(
            top, "diff", "--numstat", "-z", "--no-renames", diff_base(top)
        )
        for record in numstat.split("\0"):
            if not record:
                continue
            parts = record.split("\t", 2)
            if len(parts) != 3:
                raise RuntimeError("git diff returned an invalid numstat record")
            added, deleted, file_name = parts
            if added != "-" and not added.isdecimal():
                raise RuntimeError("git diff returned an invalid added-line count")
            if deleted != "-" and not deleted.isdecimal():
                raise RuntimeError("git diff returned an invalid deleted-line count")
            entries[file_name] = {
                "kind": status_kind(tracked_statuses.get(file_name, "")),
                "added": "-" if added == "-" else int(added),
                "deleted": "-" if deleted == "-" else int(deleted),
                "path": file_name,
            }

    if not scan_untracked:
        for entry in cached_untracked:
            entries.setdefault(entry["path"], entry.copy())

    def churn(entry: dict[str, Any]) -> int:
        added = entry["added"] if isinstance(entry["added"], int) else 0
        deleted = entry["deleted"] if isinstance(entry["deleted"], int) else 0
        return added + deleted

    changes = sorted(entries.values(), key=lambda entry: (-churn(entry), entry["path"]))
    return changes, untracked_entries if scan_untracked else None


def branches(stats: dict[str, dict[str, str]], field: str) -> str:
    lines: list[str] = []
    for top in sorted(stats, key=lambda item: (-len(Path(item).parts), item)):
        value = stats[top][field]
        if not value:
            continue
        top_literal = swift_literal(top)
        lines.append(
            f'  if d == "{top_literal}" || d.hasPrefix("{top_literal}/") {{ return "{swift_literal(value)}" }}\n'
        )
    return "".join(lines)


def signal_usage_process_group(process: subprocess.Popen[str], signal_number: int) -> None:
    try:
        os.killpg(process.pid, signal_number)
    except (OSError, ProcessLookupError):
        pass


def stop_usage_collector(process: subprocess.Popen[str]) -> None:
    signal_usage_process_group(process, signal.SIGTERM)
    grace_deadline = time.monotonic() + 1
    try:
        process.communicate(timeout=1)
    except (OSError, subprocess.TimeoutExpired):
        pass

    remaining_grace = grace_deadline - time.monotonic()
    if remaining_grace > 0:
        time.sleep(remaining_grace)
    signal_usage_process_group(process, signal.SIGKILL)
    try:
        process.communicate(timeout=1)
    except (OSError, subprocess.TimeoutExpired):
        try:
            process.kill()
        except OSError:
            pass
        try:
            process.wait(timeout=1)
        except (OSError, subprocess.TimeoutExpired):
            pass


def run_usage_collector(usage_bin: Path, timeout: float) -> str:
    try:
        process = subprocess.Popen(
            [str(usage_bin)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            errors="surrogateescape",
            start_new_session=True,
        )
    except OSError as error:
        raise RuntimeError("usage collector could not start") from error
    try:
        output, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as error:
        stop_usage_collector(process)
        raise RuntimeError("usage collector timed out") from error
    except OSError:
        stop_usage_collector(process)
        raise
    if process.returncode != 0:
        raise RuntimeError("usage collector failed")
    return output


def usage_snapshot(
    usage_bin: Path, timeout: float = USAGE_TIMEOUT_SECONDS
) -> dict[str, dict[str, str]]:
    try:
        output = run_usage_collector(usage_bin, timeout)
        document = json.loads(output)
        providers = document["providers"]
        if not isinstance(providers, dict):
            raise RuntimeError("usage snapshot did not contain a providers object")
    except (
        OSError,
        KeyError,
        TypeError,
        json.JSONDecodeError,
        RuntimeError,
        subprocess.TimeoutExpired,
    ):
        return {
            provider: {
                "account": "unavailable",
                "account_name": "",
                "five_hour": "—",
                "seven_day": "—",
                "fable_week": "—",
                "five_hour_progress": "0.0",
                "seven_day_progress": "0.0",
                "fable_week_progress": "0.0",
                "five_hour_reset_at": "0.0",
                "seven_day_reset_at": "0.0",
                "fable_week_reset_at": "0.0",
                "detail": "error",
            }
            for provider in USAGE_PROVIDERS
        }

    snapshot: dict[str, dict[str, str]] = {}
    for provider in USAGE_PROVIDERS:
        value = providers.get(provider)
        if not isinstance(value, dict):
            snapshot[provider] = {
                "account": "unavailable",
                "account_name": "",
                "five_hour": "—",
                "seven_day": "—",
                "fable_week": "—",
                "five_hour_progress": "0.0",
                "seven_day_progress": "0.0",
                "fable_week_progress": "0.0",
                "five_hour_reset_at": "0.0",
                "seven_day_reset_at": "0.0",
                "fable_week_reset_at": "0.0",
                "detail": "unavailable",
            }
            continue

        status = value.get("status")
        account = value.get("account")
        if not isinstance(account, str) or not account:
            account = "signed out" if status == "signed_out" else "unavailable"
        account_name = value.get("account_name")
        five_hour = value.get("five_hour")
        seven_day = value.get("seven_day")
        fable_week = value.get("fable_week")
        five_hour_reset_at = value.get("five_hour_reset_at")
        seven_day_reset_at = value.get("seven_day_reset_at")
        fable_week_reset_at = value.get("fable_week_reset_at")
        detail = value.get("detail")
        snapshot[provider] = {
            "account": sanitized_field(account),
            "account_name": (
                sanitized_field(account_name)
                if isinstance(account_name, str) and account_name
                else ""
            ),
            "five_hour": usage_percent(five_hour),
            "seven_day": usage_percent(seven_day),
            "fable_week": usage_percent(fable_week),
            "five_hour_progress": usage_progress(five_hour),
            "seven_day_progress": usage_progress(seven_day),
            "fable_week_progress": usage_progress(fable_week),
            "five_hour_reset_at": usage_epoch(five_hour_reset_at),
            "seven_day_reset_at": usage_epoch(seven_day_reset_at),
            "fable_week_reset_at": usage_epoch(fable_week_reset_at),
            "detail": sanitized_field(detail) if isinstance(detail, str) and detail else "",
        }
    return snapshot


def usage_percent(value: object) -> str:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "—"
    if isinstance(value, int):
        if value < 0 or value > 100:
            return "—"
    elif not math.isfinite(value) or value < 0 or value > 100:
        return "—"
    return f"{format(value, '.6g')}%"


def usage_progress(value: object) -> str:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "0.0"
    if not math.isfinite(value) or value < 0 or value > 100:
        return "0.0"
    literal = format(value / 100, ".8g")
    if "." not in literal and "e" not in literal.lower():
        literal += ".0"
    return literal


def usage_epoch(value: object) -> str:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "0.0"
    if not math.isfinite(value) or value <= 0:
        return "0.0"
    literal = format(value, ".15g")
    if "." not in literal and "e" not in literal.lower():
        literal += ".0"
    return literal


def usage_branches(usage: dict[str, dict[str, str]]) -> str:
    lines: list[str] = []
    for provider in USAGE_PROVIDERS:
        for field in (
            "account",
            "account_name",
            "five_hour",
            "seven_day",
            "fable_week",
            "detail",
        ):
            value = swift_literal(usage[provider][field])
            lines.append(
                f'  if p == "{provider}" && f == "{field}" {{ return "{value}" }}\n'
            )
    return "".join(lines)


def usage_progress_branches(usage: dict[str, dict[str, str]]) -> str:
    lines: list[str] = []
    for provider in USAGE_PROVIDERS:
        for field in ("five_hour", "seven_day", "fable_week"):
            value = usage[provider][f"{field}_progress"]
            lines.append(
                f'  if p == "{provider}" && f == "{field}" {{ return {value} }}\n'
            )
    return "".join(lines)


def usage_reset_branches(usage: dict[str, dict[str, str]]) -> str:
    lines: list[str] = []
    for provider in USAGE_PROVIDERS:
        for field in ("five_hour", "seven_day", "fable_week"):
            value = usage[provider][f"{field}_reset_at"]
            lines.append(
                f'  if p == "{provider}" && f == "{field}" {{ return {value} }}\n'
            )
    return "".join(lines)


def generated_block(
    stats: dict[str, dict[str, str]], usage: dict[str, dict[str, str]]
) -> str:
    functions: list[str] = []
    for name, field in (
        ("diffTotalsOf", "totals"),
        ("diffTreeOf", "tree"),
        ("diffMoreOf", "more"),
        ("diffRootOf", "root"),
    ):
        functions.append(
            f"func {name}(_ dir) -> String {{\n"
            '  let d = "\\(dir)"\n'
            f"{branches(stats, field)}"
            '  return ""\n'
            "}\n"
        )
    functions.append(
        "func usageValue(_ provider, _ field) -> String {\n"
        '  let p = "\\(provider)"\n'
        '  let f = "\\(field)"\n'
        f"{usage_branches(usage)}"
        '  return ""\n'
        "}\n"
    )
    functions.append(
        "func usageProgress(_ provider, _ field) -> Double {\n"
        '  let p = "\\(provider)"\n'
        '  let f = "\\(field)"\n'
        f"{usage_progress_branches(usage)}"
        "  return 0.0\n"
        "}\n"
    )
    functions.append(
        "func usageResetAt(_ provider, _ field) -> Double {\n"
        '  let p = "\\(provider)"\n'
        '  let f = "\\(field)"\n'
        f"{usage_reset_branches(usage)}"
        "  return 0.0\n"
        "}\n"
    )
    return f"{BEGIN}\n{''.join(functions)}{END}"


def collect_stats(
    cmux_bin: str,
    cache: dict[str, Any],
    now: float,
) -> tuple[dict[str, dict[str, str]], bool]:
    stats: dict[str, dict[str, str]] = {}
    repositories = cache["repositories"]
    active_toplevels: set[str] = set()
    cache_changed = False
    for top in repository_toplevels(workspace_directories(cmux_bin)):
        top_key = str(top)
        active_toplevels.add(top_key)
        cached = repositories.get(top_key)
        scan_untracked = (
            cached is None
            or now < cached["scanned_at"]
            or now - cached["scanned_at"] >= UNTRACKED_REFRESH_SECONDS
        )
        cached_untracked = [] if cached is None else cached["entries"]
        changes, refreshed_untracked = repository_changes(
            top, cached_untracked, scan_untracked
        )
        if refreshed_untracked is not None:
            repositories[top_key] = {
                "scanned_at": now,
                "entries": refreshed_untracked,
            }
            cache_changed = True
        if not changes:
            continue
        added = sum(entry["added"] for entry in changes if isinstance(entry["added"], int))
        deleted = sum(entry["deleted"] for entry in changes if isinstance(entry["deleted"], int))
        listed = changes[:MAX_FILES_LISTED]
        stats[top_key] = {
            "totals": f"{len(changes)}|{added}|{deleted}",
            "tree": tree_rows(listed),
            "more": str(len(changes) - len(listed)) if len(changes) > len(listed) else "",
            "root": str(top),
        }
    for stale_toplevel in repositories.keys() - active_toplevels:
        del repositories[stale_toplevel]
        cache_changed = True
    return stats, cache_changed


def render_runtime(
    source: str, stats: dict[str, dict[str, str]], usage: dict[str, dict[str, str]]
) -> str:
    start = source.find(BEGIN)
    end = source.find(END, start + len(BEGIN))
    if start < 0 or end < 0:
        raise RuntimeError("managed CMUX_DIFF_DATA block is missing from Agent Board source")
    end += len(END)
    return source[:start] + generated_block(stats, usage) + source[end:]


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temporary:
            temporary.write(content)
        os.chmod(temporary_name, 0o644)
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def refresh(
    cmux_bin: str,
    source_path: Path,
    target_path: Path,
    usage_bin: Path,
    usage_timeout: float,
    cache_path: Path,
) -> bool:
    source = source_path.read_text(encoding="utf-8")
    cache = load_untracked_cache(cache_path)
    stats, cache_changed = collect_stats(cmux_bin, cache, time.time())
    runtime = render_runtime(
        source, stats, usage_snapshot(usage_bin, usage_timeout)
    )
    try:
        previous_runtime = target_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        previous_runtime = None
    if runtime == previous_runtime:
        runtime_changed = False
    else:
        write_atomic(target_path, runtime)
        run_command([cmux_bin, "sidebar", "reload", "agent-board"])
        runtime_changed = True
    if cache_changed:
        cache_content = json.dumps(cache, ensure_ascii=True, sort_keys=True) + "\n"
        write_atomic(cache_path, cache_content)
    return runtime_changed


def main() -> None:
    cmux_bin = os.environ.get("CMUX_BIN", "cmux")
    source_path = configured_path(
        "CMUX_AGENT_BOARD_SOURCE", Path.home() / ".local/share/cmux/agent-board.swift"
    )
    target_path = configured_path(
        "CMUX_AGENT_BOARD_TARGET", Path.home() / ".local/state/cmux/agent-board.swift"
    )
    lock_path = configured_path(
        "CMUX_AGENT_BOARD_LOCK", Path.home() / ".local/state/cmux/agent-board-diff-refresh.lock"
    )
    usage_bin = configured_path(
        "CMUX_AGENT_BOARD_USAGE", Path.home() / ".local/bin/cmux-agent-board-usage"
    )
    usage_timeout = configured_timeout(
        "CMUX_AGENT_BOARD_USAGE_TIMEOUT", USAGE_TIMEOUT_SECONDS
    )
    cache_path = configured_path(
        "CMUX_AGENT_BOARD_CACHE",
        Path.home() / ".local/state/cmux/agent-board-diff-cache.json",
    )
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("another cmux Agent Board diff refresh is already running") from error
        refresh(
            cmux_bin,
            source_path,
            target_path,
            usage_bin,
            usage_timeout,
            cache_path,
        )


if __name__ == "__main__":
    main()

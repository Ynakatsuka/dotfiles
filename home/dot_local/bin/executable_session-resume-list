#!/usr/bin/env python3
"""List recent sessions for the current directory without scanning whole logs."""

from __future__ import annotations

import argparse
import json
import mmap
import os
import sys
from collections.abc import Iterator, Mapping
from pathlib import Path
from time import localtime, strftime
from typing import Any


def prompt(row: dict[str, Any], tool: str) -> str:
    if tool == "claude":
        if (
            row.get("type") != "user"
            or row.get("isMeta")
            or row.get("isCompactSummary")
        ):
            return ""
        content = row["message"]["content"]
        if isinstance(content, str):
            return content
        return "\n".join(part["text"] for part in content if part["type"] == "text")

    payload = row.get("payload", {})
    if row.get("type") == "event_msg" and payload.get("type") == "user_message":
        return payload["message"]
    if (
        row.get("type") == "response_item"
        and payload.get("type") == "message"
        and payload.get("role") == "user"
    ):
        return "\n".join(
            part["text"]
            for part in payload["content"]
            if part["type"] == "input_text"
            and not part["text"].startswith(
                ("# AGENTS.md instructions", "<environment_context>")
            )
            and "<INSTRUCTIONS>" not in part["text"]
        )
    return ""


def lines(data: mmap.mmap, *, reverse: bool) -> Iterator[bytes]:
    if not reverse:
        while line := data.readline():
            yield line
        return

    end = len(data)
    while end:
        if data[end - 1 : end] == b"\n":
            end -= 1
        start = data.rfind(b"\n", 0, end) + 1
        yield data[start:end]
        end = start


def read_prompt(data: mmap.mmap, tool: str, *, reverse: bool) -> str:
    for line in lines(data, reverse=reverse):
        # Most log entries are assistant output or tool results. Avoid decoding
        # those large JSON objects when looking for user messages.
        if b'"user"' not in line and b'"user_message"' not in line:
            continue
        text = prompt(json.loads(line), tool)
        if text.strip():
            return text
    return ""


def prompts(file_path: Path, tool: str) -> tuple[str, str]:
    with file_path.open("rb") as stream:
        if os.fstat(stream.fileno()).st_size == 0:
            return "", ""
        with mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as data:
            return read_prompt(data, tool, reverse=False), read_prompt(
                data, tool, reverse=True
            )


def orca_user_data(home: Path, environ: Mapping[str, str]) -> Path:
    # Orca exports its data directory to its terminals. Elsewhere, use the
    # Electron userData default for the app name "orca".
    if user_data := environ.get("ORCA_USER_DATA_PATH"):
        return Path(user_data)
    if sys.platform == "darwin":
        return home / "Library/Application Support/orca"
    return Path(environ.get("XDG_CONFIG_HOME") or home / ".config") / "orca"


def codex_homes(home: Path, environ: Mapping[str, str]) -> list[Path]:
    """Return the Codex homes to scan, starting with the one `codex resume` uses.

    Orca starts Codex with CODEX_HOME set to a per-account home, so sessions
    started from Orca are stored under codex-accounts/<id>/home, not ~/.codex.
    """
    homes = []
    if current := environ.get("CODEX_HOME"):
        homes.append(Path(current))
    homes.append(home / ".codex")
    homes.extend(
        sorted((orca_user_data(home, environ) / "codex-accounts").glob("*/home"))
    )
    return homes


def sessions(
    home: Path, cwd: str, limit: int, environ: Mapping[str, str]
) -> Iterator[str]:
    project = cwd.replace("/", "-").replace(".", "-")
    claude_home = home / ".claude"
    # (mtime, home priority, tool, transcript, home that owns the transcript)
    candidates = [
        (file_path.stat().st_mtime, 0, "claude", file_path, claude_home)
        for file_path in (claude_home / "projects" / project).glob("*.jsonl")
        if len(file_path.stem) == 36 and not file_path.stem.startswith("agent-")
    ]
    # Orca hard-links one rollout into several account homes, and CODEX_HOME
    # usually names one of the scanned homes. Keep the first home's path for
    # each file so a session in the current home resumes without CODEX_HOME.
    # Codex replaces idle rollouts with *.jsonl.zst. They are not listed: the
    # mise-managed Python 3.12 has no zstd decoder, and starting one zstd
    # process per file takes seconds. Codex's own `codex resume` picker can.
    seen_files = set()
    for priority, codex_home in enumerate(codex_homes(home, environ)):
        for file_path in (codex_home / "sessions").rglob("*.jsonl"):
            status = file_path.stat()
            if (status.st_dev, status.st_ino) in seen_files:
                continue
            seen_files.add((status.st_dev, status.st_ino))
            candidates.append(
                (status.st_mtime, priority, "codex", file_path, codex_home)
            )

    count = 0
    seen_sessions = set()
    for mtime, _, tool, file_path, session_home in sorted(
        candidates, key=lambda candidate: (-candidate[0], candidate[1])
    ):
        if tool == "codex":
            # cwd and id are in the first record; unrelated session bodies do
            # not need to be searched, even when they contain this cwd as text.
            with file_path.open("rb") as stream:
                first_line = stream.readline()
            if not first_line:
                continue
            meta = json.loads(first_line)
            if meta["type"] != "session_meta":
                raise ValueError(f"Missing session_meta in {file_path}")
            if meta["payload"]["cwd"] != cwd:
                continue
            session_id = meta["payload"]["id"]
        else:
            session_id = file_path.stem
        # A session copied between homes keeps its id; list its newest copy.
        if (tool, session_id) in seen_sessions:
            continue
        seen_sessions.add((tool, session_id))

        first, latest = prompts(file_path, tool)
        yield "\t".join(
            (
                tool,
                strftime("%m/%d %H:%M", localtime(mtime)),
                "First: " + (" ".join(first.split())[:120] if first else "(no prompt)"),
                "Latest: "
                + (" ".join(latest.split())[:120] if latest else "(no prompt)"),
                session_id,
                str(file_path),
                str(session_home),
            )
        )
        count += 1
        if count >= limit:
            break


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--limit", type=int, default=100)
    parser.add_argument("--preview", nargs=2, metavar=("TOOL", "FILE"))
    args = parser.parse_args()
    if args.limit < 1:
        parser.error("--limit must be a positive integer")
    if args.preview:
        tool, filename = args.preview
        if tool not in ("claude", "codex"):
            parser.error("TOOL must be claude or codex")
        first, latest = prompts(Path(filename), tool)
        print(f"First prompt\n{first}\n\nLatest prompt\n{latest}")
    else:
        # Buffer at most 100 rows so a read error never looks like a successful
        # partial list to the calling widget.
        rows = list(
            sessions(Path.home(), os.getcwd(), min(args.limit, 100), os.environ)
        )
        if rows:
            print("\n".join(rows))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"session-resume-list: {error}", file=sys.stderr)
        sys.exit(1)

#!/usr/bin/env bash
# Fast-forward local base branches of ghq repositories to origin.
#
# For each primary clone directly under <host>/OWNER/ (linked worktrees are
# skipped), fetch origin and fast-forward every existing local base branch to
# origin/<branch>. A branch checked out in a worktree is merged with --ff-only
# there so the files follow. A branch with commits missing from origin is left
# unchanged and reported. Repositories are synced in parallel, and each
# repository's output is printed as one block in ghq list order.

set -euo pipefail

BASE_BRANCHES="main master develop staging production"
# Keep concurrent SSH connections to one host under common server limits.
MAX_JOBS=8
FAILURES=0
REPOS=()
LABELS=()

usage() {
  echo "Usage: git-sync-base-branches [OWNER...]"
  echo "Without OWNER, sync every ghq repository."
}

fail() {
  echo "[ERROR] $*" >&2
  FAILURES=$((FAILURES + 1))
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Print the path of the worktree that has refs/heads/<branch> checked out.
checked_out_worktree() {
  local repo=$1 branch=$2
  git -C "$repo" worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '
    /^worktree / { path = substr($0, 10) }
    $0 == ref && !found { print path; found = 1 }
  '
}

sync_branch() {
  local repo=$1 label=$2 branch=$3 local_sha remote_sha worktree count
  local_sha=$(git -C "$repo" rev-parse "refs/heads/$branch")
  if ! remote_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$branch"); then
    echo "[WARN] $label $branch: origin/$branch not found; skipped" >&2
    return
  fi
  if [ "$local_sha" = "$remote_sha" ]; then
    echo "$label $branch: up to date"
    return
  fi
  if ! git -C "$repo" merge-base --is-ancestor "$local_sha" "$remote_sha"; then
    fail "$label $branch: has commits not on origin/$branch; left unchanged"
    return
  fi

  count=$(git -C "$repo" rev-list --count "$local_sha..$remote_sha")
  worktree=$(checked_out_worktree "$repo" "$branch")
  if [ -n "$worktree" ]; then
    if ! git -C "$worktree" merge --ff-only --quiet "refs/remotes/origin/$branch"; then
      fail "$label $branch: fast-forward failed in $worktree"
      return
    fi
  # Fetching into the local ref refuses non-fast-forward updates and branches
  # that a worktree is rebasing or bisecting.
  elif ! git -C "$repo" fetch --quiet . "refs/remotes/origin/$branch:refs/heads/$branch"; then
    fail "$label $branch: fast-forward failed"
    return
  fi
  echo "$label $branch: ${local_sha:0:7}..${remote_sha:0:7} ($count commits)"
}

sync_repo() {
  local repo=$1 label=$2 branch
  if ! git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    fail "$label: no origin remote"
    return
  fi
  # Prune so a branch deleted on origin is skipped instead of following its
  # stale tracking ref.
  if ! git -C "$repo" fetch --quiet --prune origin; then
    fail "$label: git fetch origin failed"
    return
  fi
  for branch in $BASE_BRANCHES; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      sync_branch "$repo" "$label" "$branch"
    fi
  done
}

# Queue primary clones whose owner matches OWNER_KEY, or all of them when it is empty.
queue_owner() {
  local owner_key=$1 repo parent matched=0
  while IFS= read -r repo; do
    [ -d "$repo/.git" ] || continue
    # Skip clones nested deeper than <root>/<host>/<owner>/<repo>.
    grep -Fxq -- "${repo%/*/*/*}" <<<"$GHQ_ROOTS" || continue
    parent=${repo%/*}
    if [ -n "$owner_key" ] && [ "$(lowercase "${parent##*/}")" != "$owner_key" ]; then
      continue
    fi
    matched=1
    REPOS+=("$repo")
    LABELS+=("${parent##*/}/${repo##*/}")
  done <<<"$GHQ_REPOS"
  [ "$matched" -eq 1 ]
}

# Sync one queued repository, buffering its output and failure count in OUT_DIR.
sync_job() {
  local index=$1
  FAILURES=0
  # Keep git subprocesses from reading the terminal on stdin.
  sync_repo "${REPOS[$index]}" "${LABELS[$index]}" \
    >"$OUT_DIR/$index.out" 2>"$OUT_DIR/$index.err" </dev/null
  echo "$FAILURES" >"$OUT_DIR/$index.failures"
}

sync_queued() {
  local index
  [ "${#REPOS[@]}" -gt 0 ] || return 0
  OUT_DIR=$(mktemp -d)
  trap 'rm -rf "$OUT_DIR"' EXIT
  # Run fixed batches with plain wait; macOS /bin/bash 3.2 has no wait -n.
  for index in "${!REPOS[@]}"; do
    sync_job "$index" &
    if [ $(((index + 1) % MAX_JOBS)) -eq 0 ]; then
      wait
    fi
  done
  wait
  for index in "${!REPOS[@]}"; do
    cat "$OUT_DIR/$index.out"
    cat "$OUT_DIR/$index.err" >&2
    FAILURES=$((FAILURES + $(cat "$OUT_DIR/$index.failures")))
  done
}

main() {
  local owner
  case ${1:-} in
    -h | --help)
      usage
      return 0
      ;;
  esac

  GHQ_ROOTS=$(ghq root --all)
  GHQ_REPOS=$(ghq list --full-path)
  if [ "$#" -eq 0 ]; then
    queue_owner "" || fail "no ghq repositories found"
  fi
  for owner in "$@"; do
    # GitHub owner names are case-insensitive.
    queue_owner "$(lowercase "$owner")" || fail "no ghq repositories found for owner: $owner"
  done
  sync_queued

  if [ "$FAILURES" -gt 0 ]; then
    echo "[ERROR] git-sync-base-branches: $FAILURES problem(s) reported above" >&2
    return 1
  fi
}

main "$@"

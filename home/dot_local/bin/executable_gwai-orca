#!/usr/bin/env bash
# Create a top-level Orca worktree in the repository of the workspace selected
# in the Orca UI and start an agent with the original prompt.

set -euo pipefail

readonly ORCA_BIN="${ORCA_BIN:-/Applications/Orca.app/Contents/Resources/bin/orca}"
# Orca writes the config directory of the Claude account selected for new
# launches here. It removes the file when it manages no Claude accounts and
# leaves it empty when the system default account is selected.
readonly ORCA_CLAUDE_PROFILE_POINTER="${ORCA_CLAUDE_PROFILE_POINTER:-$HOME/Library/Application Support/orca/claude-profiles/selected-host}"

usage() {
  cat <<'USAGE'
Usage: gwai-orca [--provider claude|codex] <prompt>

Creates a new top-level Orca worktree in the repository of the workspace
currently selected in the Orca UI, names it with gwai-worktree-name
(YYMMDD-<Japanese name of up to 10 characters>, or YYMMDD-<client>-<name>
when <prompt> names a client company), and starts the chosen agent with
<prompt> in the new workspace.

If --provider is omitted, claude is used.
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  local name="$1"

  command -v "$name" >/dev/null 2>&1 || die "$name not found in PATH"
}

# The Raycast aio command shows each stdout line as the current step, and its
# final HUD shows the last line, so the result stays last.
report_step() {
  printf '%s\n' "$1"
}

print_orca_response() {
  local response="$1"

  [[ -n "$response" ]] || return 0
  printf '%s\n' "$response" >&2
}

validate_provider() {
  local provider="$1"

  [[ "$provider" == 'claude' || "$provider" == 'codex' ]] ||
    die "provider is invalid: $provider"
}

read_active_repo_id() {
  local ps_json

  if ! ps_json=$("$ORCA_BIN" worktree ps --json); then
    print_orca_response "$ps_json"
    die "failed to list Orca worktrees"
  fi

  # The running Orca app marks the workspace selected in its UI as isActive.
  active_repo_id=$(jq -er '
    if .ok != true then
      error("Orca did not list worktrees: \(.error | tojson)")
    else
      [.result.worktrees[] | select(.isActive == true) | .repoId] |
      if length == 1 and (.[0] | type == "string" and length > 0) then
        .[0]
      else
        error("expected exactly one active Orca workspace, found \(length)")
      end
    end
  ' <<<"$ps_json") ||
    die "failed to read the repository of the active Orca workspace"
}

# Name the worktree with the Claude account Orca launches agents with, not the
# system default account that Raycast would otherwise use.
use_orca_claude_account() {
  local config_dir

  [[ -f "$ORCA_CLAUDE_PROFILE_POINTER" ]] || return 0
  config_dir=$(<"$ORCA_CLAUDE_PROFILE_POINTER") ||
    die "failed to read the Orca Claude account: $ORCA_CLAUDE_PROFILE_POINTER"
  [[ -n "$config_dir" ]] || return 0
  [[ -d "$config_dir" ]] ||
    die "Orca Claude account directory not found: $config_dir"
  export CLAUDE_CONFIG_DIR="$config_dir"
}

create_worktree() {
  local branch_name="$1"
  local create_json

  if ! create_json=$("$ORCA_BIN" worktree create \
    --repo "id:${active_repo_id}" \
    --no-parent \
    --name "$branch_name" \
    --agent "$provider" \
    --prompt "$prompt" \
    --activate \
    --json); then
    print_orca_response "$create_json"
    die "failed to create the Orca worktree"
  fi

  if ! jq -e '.ok == true' <<<"$create_json" >/dev/null; then
    print_orca_response "$create_json"
    die "Orca did not confirm worktree creation"
  fi
}

provider='claude'
prompt=''

while (($# > 0)); do
  case "$1" in
    --provider)
      (($# >= 2)) || die '--provider requires claude or codex'
      provider="$2"
      shift 2
      ;;
    --provider=*)
      provider="${1#--provider=}"
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

(($# == 1)) || die 'exactly one prompt is required'
prompt="$1"

[[ -n "$prompt" ]] || die 'prompt is empty'
validate_provider "$provider"
require_command jq
require_command gwai-worktree-name
[[ -x "$ORCA_BIN" ]] || die "Orca executable not found: $ORCA_BIN"

active_repo_id=''
report_step 'Reading the selected Orca workspace...'
read_active_repo_id
use_orca_claude_account
report_step 'Naming the worktree...'
workspace_name=$(gwai-worktree-name -- "$prompt") ||
  die "failed to name the Orca worktree"
report_step "Creating Orca worktree: ${workspace_name}..."
create_worktree "$workspace_name"

printf 'Created Orca worktree: %s\n' "$workspace_name"

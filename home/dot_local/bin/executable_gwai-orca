#!/usr/bin/env bash
# Create an Orca worktree from the workspace selected in the Orca UI and start
# an agent with the original prompt.

set -euo pipefail

readonly ORCA_BIN="${ORCA_BIN:-/Applications/Orca.app/Contents/Resources/bin/orca}"
readonly ORCA_DATA_FILE="${ORCA_DATA_FILE:-$HOME/Library/Application Support/orca/profiles/local-default/orca-data.json}"
readonly BRANCH_NAME_MODEL="${GWAI_BRANCH_MODEL:-haiku}"

usage() {
  cat <<'USAGE'
Usage: gwai-orca [--provider claude|codex] <prompt>

Creates an Orca worktree from the workspace currently selected in the Orca UI,
generates a branch name with a lightweight Claude model, and starts the chosen
agent with <prompt> in the new workspace.

If --provider is omitted, codex is used.
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

source "$(dirname "${BASH_SOURCE[0]}")/../libexec/gwai/branch-name.bash"

require_command() {
  local name="$1"

  command -v "$name" >/dev/null 2>&1 || die "$name not found in PATH"
}

print_orca_response() {
  local response="$1"

  [[ -n "$response" ]] || return 0
  printf '%s\n' "$response" >&2
}

validate_provider() {
  local provider="$1"

  [[ "$provider" == 'claude' || "$provider" == 'codex' ]] ||
    die "provider is invalid: $provider"
}

read_active_workspace_ids() {
  local workspace_ids_json

  [[ -f "$ORCA_DATA_FILE" ]] ||
    die "Orca data file does not exist: $ORCA_DATA_FILE"
  [[ -r "$ORCA_DATA_FILE" ]] ||
    die "Orca data file is not readable: $ORCA_DATA_FILE"

  workspace_ids_json=$(jq -ce '
    if (
      (.workspaceSession.activeRepoId? | type == "string" and length > 0) and
      (.workspaceSession.activeWorktreeId? | type == "string" and length > 0)
    ) then
      {
        repoId: .workspaceSession.activeRepoId,
        worktreeId: .workspaceSession.activeWorktreeId
      }
    else
      error("active Orca workspace is missing")
    end
  ' "$ORCA_DATA_FILE") ||
    die "failed to read the active Orca workspace from: $ORCA_DATA_FILE"

  active_repo_id=$(jq -er '.repoId' <<<"$workspace_ids_json") ||
    die "failed to parse the active Orca repository ID"
  active_worktree_id=$(jq -er '.worktreeId' <<<"$workspace_ids_json") ||
    die "failed to parse the active Orca worktree ID"
}

validate_active_worktree() {
  local show_json

  if ! show_json=$("$ORCA_BIN" worktree show --worktree "worktree:${active_worktree_id}" --json); then
    print_orca_response "$show_json"
    die "failed to read the active Orca worktree"
  fi

  if ! jq -e \
    --arg active_repo_id "$active_repo_id" \
    --arg active_worktree_id "$active_worktree_id" \
    '.ok == true and .result.worktree.repoId == $active_repo_id and .result.worktree.id == $active_worktree_id' \
    <<<"$show_json" >/dev/null; then
    print_orca_response "$show_json"
    die "active Orca worktree is invalid or does not match the selected workspace"
  fi
}

create_worktree() {
  local branch_name="$1"
  local create_json

  if ! create_json=$("$ORCA_BIN" worktree create \
    --repo "id:${active_repo_id}" \
    --parent-worktree "worktree:${active_worktree_id}" \
    --name "$branch_name" \
    --agent "$provider" \
    --prompt "$prompt" \
    --activate \
    --json); then
    print_orca_response "$create_json"
    die "failed to create the Orca worktree"
  fi

  if ! jq -e '.ok == true' <<<"$create_json" >/dev/null; then
    print_orca_response "$create_json"
    die "Orca did not confirm worktree creation"
  fi
}

provider='codex'
prompt=''

while (($# > 0)); do
  case "$1" in
    --provider)
      (($# >= 2)) || die '--provider requires claude or codex'
      provider="$2"
      shift 2
      ;;
    --provider=*)
      provider="${1#--provider=}"
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

(($# == 1)) || die 'exactly one prompt is required'
prompt="$1"

[[ -n "$prompt" ]] || die 'prompt is empty'
validate_provider "$provider"
require_command jq
require_command claude
[[ -x "$ORCA_BIN" ]] || die "Orca executable not found: $ORCA_BIN"

active_repo_id=''
active_worktree_id=''
read_active_workspace_ids
validate_active_worktree
branch_name=$(generate_branch_name "$prompt" "$BRANCH_NAME_MODEL")
create_worktree "$branch_name"

printf 'Created Orca worktree: %s\n' "$branch_name"

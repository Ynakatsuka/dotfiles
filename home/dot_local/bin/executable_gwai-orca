#!/usr/bin/env bash
# Create a top-level Orca worktree in the repository of the workspace selected
# in the Orca UI and start an agent with the original prompt.

set -euo pipefail

readonly ORCA_BIN="${ORCA_BIN:-/Applications/Orca.app/Contents/Resources/bin/orca}"
readonly BRANCH_NAME_MODEL="${GWAI_BRANCH_MODEL:-haiku}"

usage() {
  cat <<'USAGE'
Usage: gwai-orca [--provider claude|codex] <prompt>

Creates a new top-level Orca worktree in the repository of the workspace
currently selected in the Orca UI, names it YYMMDD-<Japanese name of up to 10
characters> with a lightweight Claude model, and starts the chosen agent with
<prompt> in the new workspace.

If --provider is omitted, claude is used.
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  local name="$1"

  command -v "$name" >/dev/null 2>&1 || die "$name not found in PATH"
}

print_orca_response() {
  local response="$1"

  [[ -n "$response" ]] || return 0
  printf '%s\n' "$response" >&2
}

validate_provider() {
  local provider="$1"

  [[ "$provider" == 'claude' || "$provider" == 'codex' ]] ||
    die "provider is invalid: $provider"
}

generate_workspace_name() {
  local prompt="$1"
  local naming_prompt naming_output workspace_name

  naming_prompt="次のタスクのワークスペース名の候補を日本語で5つ作ってください。
ルール:
- 対象と作業が分かる短い名前にする。細部は省く
- 各候補は4〜8文字。長くても10文字まで
- 使える文字はひらがな、カタカナ、漢字、英数字、アンダースコアだけ。空白、記号、句読点は使わない
- 1行に1候補、良い順に出力する。番号、引用符、説明は付けない
- 例: パスワード再設定修正、BQコスト削減、レビュー指摘対応

タスク: ${prompt}"

  # Naming needs one short reply, so skip settings, hooks, MCP servers, skills,
  # and tools to cut Claude Code startup and prompt size.
  naming_output=$(claude -p --model "$BRANCH_NAME_MODEL" --effort low \
    --setting-sources '' --strict-mcp-config --disable-slash-commands \
    --no-session-persistence --tools '' \
    --system-prompt 'Follow the user instruction exactly. Output only the requested text.' \
    "$naming_prompt") ||
    die "workspace name generation failed"

  # Haiku often miscounts Japanese characters, so it returns several candidates
  # and the first valid one wins. jq counts characters regardless of locale.
  workspace_name=$(jq -Rnr '
    [
      inputs |
      gsub("^\\s+|\\s+$"; "") |
      select(test("^[\\p{Han}\\p{Hiragana}\\p{Katakana}ーA-Za-z0-9_]{1,10}$"))
    ] | first // empty
  ' <<<"$naming_output") ||
    die "failed to read generated workspace names"

  [[ -n "$workspace_name" ]] ||
    die "no generated workspace name had 10 or fewer allowed characters: $naming_output"

  printf '%s\n' "$workspace_name"
}

read_active_repo_id() {
  local ps_json

  if ! ps_json=$("$ORCA_BIN" worktree ps --json); then
    print_orca_response "$ps_json"
    die "failed to list Orca worktrees"
  fi

  # The running Orca app marks the workspace selected in its UI as isActive.
  active_repo_id=$(jq -er '
    if .ok != true then
      error("Orca did not list worktrees: \(.error | tojson)")
    else
      [.result.worktrees[] | select(.isActive == true) | .repoId] |
      if length == 1 and (.[0] | type == "string" and length > 0) then
        .[0]
      else
        error("expected exactly one active Orca workspace, found \(length)")
      end
    end
  ' <<<"$ps_json") ||
    die "failed to read the repository of the active Orca workspace"
}

create_worktree() {
  local branch_name="$1"
  local create_json

  if ! create_json=$("$ORCA_BIN" worktree create \
    --repo "id:${active_repo_id}" \
    --no-parent \
    --name "$branch_name" \
    --agent "$provider" \
    --prompt "$prompt" \
    --activate \
    --json); then
    print_orca_response "$create_json"
    die "failed to create the Orca worktree"
  fi

  if ! jq -e '.ok == true' <<<"$create_json" >/dev/null; then
    print_orca_response "$create_json"
    die "Orca did not confirm worktree creation"
  fi
}

provider='claude'
prompt=''

while (($# > 0)); do
  case "$1" in
    --provider)
      (($# >= 2)) || die '--provider requires claude or codex'
      provider="$2"
      shift 2
      ;;
    --provider=*)
      provider="${1#--provider=}"
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

(($# == 1)) || die 'exactly one prompt is required'
prompt="$1"

[[ -n "$prompt" ]] || die 'prompt is empty'
validate_provider "$provider"
require_command jq
require_command claude
[[ -x "$ORCA_BIN" ]] || die "Orca executable not found: $ORCA_BIN"

active_repo_id=''
read_active_repo_id
date_prefix=$(date '+%y%m%d')
[[ "$date_prefix" =~ ^[0-9]{6}$ ]] || die "date prefix is invalid: $date_prefix"
workspace_name="${date_prefix}-$(generate_workspace_name "$prompt")"
create_worktree "$workspace_name"

printf 'Created Orca worktree: %s\n' "$workspace_name"

#!/usr/bin/env bash
# Disable the retained cmux Agent Board integration while Orca is primary.

set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  exit 0
fi

readonly CMUX_BUNDLE_ID="com.cmuxterm.app"
readonly DIFF_JOB_LABEL="com.cmuxterm.agent-board-diff"
readonly USAGE_JOB_LABEL="com.cmuxterm.agent-board-usage"

launch_domain="gui/$(id -u)"
for job_label in "${USAGE_JOB_LABEL}" "${DIFF_JOB_LABEL}"; do
  if launchctl print "${launch_domain}/${job_label}" >/dev/null 2>&1; then
    launchctl bootout "${launch_domain}/${job_label}"
  fi
done

for preference_key in customSidebars.beta.enabled cmuxExtensionSidebar.providerId; do
  if defaults read "${CMUX_BUNDLE_ID}" "${preference_key}" >/dev/null 2>&1; then
    defaults delete "${CMUX_BUNDLE_ID}" "${preference_key}"
  fi
done

disabled_targets=(
  "${HOME}/.config/zsh/cmux-agent-board.zsh"
  "${HOME}/.local/bin/gwai-cmux"
  "${HOME}/.raycast/scripts/gwai-cmux.sh"
  "${HOME}/Library/LaunchAgents/${DIFF_JOB_LABEL}.plist"
  "${HOME}/Library/LaunchAgents/${USAGE_JOB_LABEL}.plist"
  "${HOME}/.local/state/cmux/agent-board.swift"
)
for target_file in "${disabled_targets[@]}"; do
  if [[ -f "${target_file}" || -L "${target_file}" ]]; then
    rm "${target_file}"
  fi
done

echo "Disabled cmux Agent Board and its refresh jobs."
